# Real photos uploaded through the admin photo editor -- keep the folder, not its contents.
data/pictures/*
!data/pictures/.keep

# Dev-only tooling lives in the sibling kid-zone-app-dev folder, never here, but ignore
# defensively in case it ever reappears.
node_modules/
_backup-before-*/

# Align tools need to live next to assets/icons (relative image paths + serve.js's single root),
# so they stay here instead of kid-zone-app-dev -- not part of the shipped app, just excluded from
# git rather than relocated.
*-align-tool.html

# OS/editor cruft
Thumbs.db
desktop.ini
.DS_Store
